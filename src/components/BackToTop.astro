---
// Floating HUD Back-to-Top widget with real-time reading progress ring for articles
---

<button
	id="back-to-top-btn"
	class="back-to-top-fab"
	type="button"
	aria-label="回到文章开头"
	title="回到文章开头 (Back to Top)"
>
	<span class="btt-ring-wrap">
		<svg class="btt-ring" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
			<circle
				class="btt-ring-bg"
				cx="20"
				cy="20"
				r="16"
				fill="none"
				stroke-width="2.5"
			/>
			<circle
				id="btt-progress-circle"
				class="btt-ring-progress"
				cx="20"
				cy="20"
				r="16"
				fill="none"
				stroke-width="2.5"
				stroke-dasharray="100.53"
				stroke-dashoffset="100.53"
				stroke-linecap="round"
			/>
		</svg>
		<span class="btt-arrow">↑</span>
	</span>
	<span class="btt-text">
		<span class="btt-title">TOP // 回到开头</span>
		<span class="btt-percent" id="btt-percent-text">⚡ 0%</span>
	</span>
</button>

<script is:inline>
	(function () {
		const btn = document.getElementById("back-to-top-btn");
		const circle = document.getElementById("btt-progress-circle");
		const percentText = document.getElementById("btt-percent-text");
		if (!btn) return;

		const circumference = 2 * Math.PI * 16; // ~100.53

		function updateScrollState() {
			const scrollTop = window.scrollY || document.documentElement.scrollTop;
			const docHeight =
				document.documentElement.scrollHeight - document.documentElement.clientHeight;
			const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;
			const pct = Math.round(progress * 100);

			if (scrollTop > 220) {
				btn.classList.add("is-visible");
			} else {
				btn.classList.remove("is-visible");
			}

			if (circle) {
				const offset = circumference - progress * circumference;
				circle.style.strokeDashoffset = String(offset);
			}

			if (percentText) {
				percentText.textContent = `⚡ ${pct}%`;
			}
		}

		window.addEventListener("scroll", updateScrollState, { passive: true });
		window.addEventListener("resize", updateScrollState, { passive: true });
		updateScrollState();

		btn.addEventListener("click", () => {
			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		});
	})();
</script>

<style>
	.back-to-top-fab {
		position: fixed;
		right: 1.4rem;
		bottom: 5.1rem;
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.85rem 0.4rem 0.45rem;
		border-radius: 999px;
		background: var(--bg-glass);
		border: 1px solid var(--border-hud-strong);
		box-shadow: var(--glow-electric);
		color: var(--text-primary);
		font-family: inherit;
		cursor: pointer;
		backdrop-filter: blur(12px);
		opacity: 0;
		visibility: hidden;
		transform: translateY(14px) scale(0.95);
		transition:
			opacity 0.25s ease,
			visibility 0.25s ease,
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.back-to-top-fab.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
	}

	.back-to-top-fab:hover {
		transform: translateY(-3px) scale(1.03);
		border-color: var(--accent);
		box-shadow: var(--glow-electric), 0 0 20px rgba(0, 229, 255, 0.45);
	}

	.back-to-top-fab:active {
		transform: translateY(0) scale(0.97);
	}

	.btt-ring-wrap {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
	}

	.btt-ring {
		transform: rotate(-90deg);
	}

	.btt-ring-bg {
		stroke: var(--border-subtle);
	}

	.btt-ring-progress {
		stroke: var(--accent);
		transition: stroke-dashoffset 0.1s linear;
		filter: drop-shadow(0 0 4px var(--accent));
	}

	.btt-arrow {
		position: absolute;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--accent-coin);
		line-height: 1;
		transition: transform 0.2s ease;
	}

	.back-to-top-fab:hover .btt-arrow {
		transform: translateY(-2px);
	}

	.btt-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1.15;
	}

	.btt-title {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--text-primary);
	}

	.btt-percent {
		font-size: 0.72rem;
		font-family: "JetBrains Mono", Consolas, monospace;
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.back-to-top-fab {
			right: 0.9rem;
			bottom: 4.3rem;
			padding: 0.35rem 0.65rem 0.35rem 0.35rem;
		}
		.btt-title {
			display: none;
		}
	}
</style>
