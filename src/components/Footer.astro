---
import { MISAKA_PROFILE } from "../consts";
import RailgunWidget from "./RailgunWidget.astro";
import SocialLinks from "./SocialLinks.astro";

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-badges">
			<span class="hud-tag">⚡ {MISAKA_PROFILE.rank}</span>
			<span class="hud-badge-coin">🪙 {MISAKA_PROFILE.voltage}</span>
			<span class="hud-badge-gekota">
				<img src="/favicon.svg" alt="Gekota" width="14" height="14" />
				GEKOTA GUARDIAN
			</span>
		</div>

		<p class="footer-quote">「{MISAKA_PROFILE.subSlogan}」</p>

		<div class="footer-meta">
			<span>&copy; {today.getFullYear()} Ecator. All rights reserved.</span>
			<span class="meta-sep">//</span>
			<span class="meta-code">ACADEMY CITY TERMINAL · MISAKA.COOL</span>
		</div>

		<div class="footer-social">
			<SocialLinks />
		</div>
	</div>

	<RailgunWidget />
</footer>

<style>
	.site-footer {
		position: relative;
		margin-top: auto;
		padding: 2.5rem 1rem 4.5rem;
		background: var(--bg-glass);
		border-top: 1px solid var(--border-hud);
		text-align: center;
		color: var(--text-secondary);
	}

	.site-footer::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--accent), var(--accent-coin), var(--accent), transparent);
	}

	.footer-inner {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.9rem;
	}

	.footer-badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.footer-badges img {
		border-radius: 0;
	}

	.footer-quote {
		margin: 0.2rem 0;
		font-size: 0.95rem;
		color: var(--text-primary);
		letter-spacing: 0.03em;
	}

	.footer-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.82rem;
		color: var(--text-muted);
		font-family: "JetBrains Mono", Consolas, monospace;
	}

	.meta-sep {
		color: var(--accent);
	}

	.footer-social {
		margin-top: 0.25rem;
	}
</style>
