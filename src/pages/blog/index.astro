---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) =>
		(b.data.updatedDate ?? b.data.pubDate).valueOf() -
		(a.data.updatedDate ?? a.data.pubDate).valueOf(),
);

const allTags = Array.from(
	new Set(posts.flatMap((post) => post.data.tags ?? [])),
).sort();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Blog // ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Archive HUD Header -->
			<section class="archive-header hud-card">
				<div class="archive-title-row">
					<div>
						<span class="archive-kicker">⚡ ELECTROMAGNETIC ARCHIVES // LEVEL 5 LOGS</span>
						<h1>全部博客文章</h1>
						<p class="archive-subtitle">
							已收录 <strong>{posts.length}</strong> 篇学习笔记与技术折腾档案
						</p>
					</div>
					<div class="archive-badges">
						<span class="hud-badge-coin">🪙 SYNCED: 100%</span>
						<span class="hud-badge-gekota">
							<img src="/favicon.svg" alt="Gekota" width="14" height="14" />
							GEKOTA INDEX
						</span>
					</div>
				</div>

				{
					allTags.length > 0 && (
						<div class="tag-filter-bar" role="toolbar" aria-label="按标签筛选文章">
							<button
								type="button"
								class="filter-chip is-active"
								data-filter-tag="all"
							>
								⚡ 全部 ({posts.length})
							</button>
							{allTags.map((tag) => (
								<button
									type="button"
									class="filter-chip"
									data-filter-tag={tag}
								>
									#{tag}
								</button>
							))}
						</div>
					)
				}
			</section>

			<!-- Posts List -->
			<section>
				<ul class="archive-grid" id="archive-post-list">
					{
						posts.map((post, idx) => {
							const serialNo = String(posts.length - idx).padStart(3, '0');
							const tagList = post.data.tags ?? [];
							return (
								<li
									class="archive-item hud-card"
									data-tags={tagList.join(',')}
								>
									<a href={`/blog/${post.id}/`} class="archive-card-link">
										{post.data.heroImage && (
											<div class="archive-thumb">
												<Image
													width={720}
													height={360}
													src={post.data.heroImage}
													alt={post.data.title}
												/>
											</div>
										)}

										<div class="archive-card-body">
											<div class="archive-meta">
												<span class="serial-badge">⚡ RECORD #{serialNo}</span>
												<span class="date">
													<FormattedDate date={post.data.updatedDate ?? post.data.pubDate} />
												</span>
											</div>

											<h2 class="title">{post.data.title}</h2>

											{post.data.description && (
												<p class="excerpt">{post.data.description}</p>
											)}

											<div class="archive-footer">
												<div class="tag-group">
													{tagList.length > 0 ? (
														tagList.map((tag) => (
															<span class="hud-tag">#{tag}</span>
														))
													) : (
														<span class="hud-tag">#log</span>
													)}
												</div>
												<span class="open-log">ACCESS LOG →</span>
											</div>
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const buttons = document.querySelectorAll('[data-filter-tag]');
				const items = document.querySelectorAll('#archive-post-list .archive-item');
				if (!buttons.length || !items.length) return;

				buttons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const selected = btn.getAttribute('data-filter-tag') || 'all';
						buttons.forEach((b) => b.classList.remove('is-active'));
						btn.classList.add('is-active');

						items.forEach((item) => {
							const raw = item.getAttribute('data-tags') || '';
							const tags = raw ? raw.split(',') : [];
							if (selected === 'all' || tags.includes(selected)) {
								item.style.display = '';
							} else {
								item.style.display = 'none';
							}
						});
					});
				});
			})();
		</script>

		<style>
			.archive-header {
				padding: 1.5rem 1.65rem;
				margin-bottom: 1.75rem;
			}

			.archive-title-row {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.archive-kicker {
				display: block;
				font-family: "JetBrains Mono", Consolas, monospace;
				font-size: 0.74rem;
				letter-spacing: 0.08em;
				color: var(--accent);
				margin-bottom: 0.25rem;
			}

			.archive-header h1 {
				margin: 0 0 0.35rem;
				font-size: 1.95rem;
			}

			.archive-subtitle {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.95rem;
			}

			.archive-badges {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.archive-badges img {
				border-radius: 0;
			}

			.tag-filter-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1.25rem;
				padding-top: 1rem;
				border-top: 1px dashed var(--border-subtle);
			}

			.filter-chip {
				padding: 0.32rem 0.75rem;
				border-radius: 999px;
				background: var(--bg-inline-code);
				border: 1px solid var(--border-hud);
				color: var(--text-secondary);
				font-family: "JetBrains Mono", Consolas, monospace;
				font-size: 0.76rem;
				font-weight: 700;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.filter-chip:hover {
				color: var(--accent);
				border-color: var(--accent);
			}

			.filter-chip.is-active {
				background: linear-gradient(135deg, var(--accent), var(--accent-blue));
				color: #ffffff;
				border-color: transparent;
				box-shadow: 0 0 14px rgba(0, 229, 255, 0.35);
			}

			.archive-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.archive-item {
				display: flex;
			}

			.archive-item:hover {
				transform: translateY(-4px);
			}

			.archive-card-link {
				display: flex;
				flex-direction: column;
				width: 100%;
				text-decoration: none;
				color: inherit;
			}

			.archive-card-link:hover {
				text-shadow: none;
			}

			.archive-thumb {
				padding: 0.85rem 0.85rem 0;
			}

			.archive-thumb img {
				width: 100%;
				height: auto;
				border-radius: 8px;
				border: 1px solid var(--border-hud);
			}

			.archive-card-body {
				display: flex;
				flex-direction: column;
				flex: 1;
				padding: 1.35rem 1.45rem;
			}

			.archive-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
				margin-bottom: 0.65rem;
				font-family: "JetBrains Mono", Consolas, monospace;
				font-size: 0.76rem;
			}

			.serial-badge {
				color: var(--accent-coin);
				font-weight: 700;
			}

			.date {
				color: var(--text-muted);
				margin: 0;
			}

			.title {
				margin: 0 0 0.55rem;
				font-size: 1.3rem;
				color: var(--text-primary);
				line-height: 1.3;
				transition: color 0.2s ease;
			}

			.archive-item:hover .title {
				color: var(--accent);
			}

			.excerpt {
				margin: 0 0 1.1rem;
				font-size: 0.92rem;
				color: var(--text-secondary);
				line-height: 1.55;
			}

			.archive-footer {
				margin-top: auto;
				padding-top: 0.8rem;
				border-top: 1px dashed var(--border-subtle);
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
			}

			.tag-group {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
			}

			.open-log {
				font-family: "JetBrains Mono", Consolas, monospace;
				font-size: 0.75rem;
				font-weight: 700;
				color: var(--accent);
				white-space: nowrap;
				transition: transform 0.2s ease, color 0.2s ease;
			}

			.archive-item:hover .open-log {
				color: var(--accent-coin);
				transform: translateX(3px);
			}

			@media (max-width: 720px) {
				.archive-header {
					padding: 1.15rem 1.1rem;
				}
				.archive-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
